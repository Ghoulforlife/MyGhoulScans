# Copy to .env or set as environment variables to enable Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# If you run on a different port/host than localhost:3000:
PORT=3000
REDIRECT_BASE=http://localhost:3000
# Comic metadata API (https://github.com/GooglyBlox/comick-source-api).
# Point at a self-hosted copy if the public instance is slow or blocked.
COMICK_API_BASE=https://comick-source-api.notaspider.dev
# Comma-separated default sources used for search when none is picked.
COMICK_SOURCES=mangaread,flamecomics,mangayy,mangataro,demonicscans