<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/mgs_bg">

    <TextView android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical"
        android:paddingStart="16dp" android:text="More" android:textColor="@color/white"
        android:textSize="19sp" android:textStyle="bold" android:background="@color/mgs_panel" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/moreList" android:orientation="vertical"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp" />
    </ScrollView>

    <include layout="@layout/bottom_nav" />
</LinearLayout>
