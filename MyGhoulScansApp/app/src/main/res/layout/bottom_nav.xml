<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomBar"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="62dp"
    android:background="@color/mgs_panel"
    android:baselineAligned="false">

    <Button android:id="@+id/navHome" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:text="⌂ Home" android:textSize="10sp"
        android:singleLine="true" android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp"
        android:textColor="@color/mgs_muted" android:background="?android:attr/selectableItemBackground" />
    <Button android:id="@+id/navSearch" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:text="⌕ Search" android:textSize="10sp"
        android:singleLine="true" android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp"
        android:textColor="@color/mgs_muted" android:background="?android:attr/selectableItemBackground" />
    <Button android:id="@+id/navLibrary" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:text="☆ Library" android:textSize="10sp"
        android:singleLine="true" android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp"
        android:textColor="@color/mgs_muted" android:background="?android:attr/selectableItemBackground" />
    <Button android:id="@+id/navDownloads" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:text="↓ Downloads" android:textSize="10sp"
        android:singleLine="true" android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp"
        android:textColor="@color/mgs_muted" android:background="?android:attr/selectableItemBackground" />
    <Button android:id="@+id/navMore" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:text="⋯ More" android:textSize="10sp"
        android:singleLine="true" android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp"
        android:textColor="@color/mgs_muted" android:background="?android:attr/selectableItemBackground" />
</LinearLayout>
