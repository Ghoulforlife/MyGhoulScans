<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000">

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">

        <WebView android:id="@+id/readerWeb" android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="#000000" />

        <View android:id="@+id/eyeOverlay" android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="#60FF8800" android:visibility="gone" />

        <TextView android:id="@+id/readerChapter"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal" android:layout_marginTop="10dp"
            android:background="#CC15151B" android:textColor="#FFFFFF" android:textSize="13sp"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="6dp" android:paddingBottom="6dp"
            android:text="" />
    </FrameLayout>

    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="52dp"
        android:background="#DD15151B" android:gravity="center_vertical">

        <Button android:id="@+id/readerBack" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:text="‹ Back" android:textSize="10sp" android:textColor="@color/mgs_accent"
            android:background="?android:attr/selectableItemBackground" />

        <Button android:id="@+id/readerPrev" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:text="‹ Prev" android:textSize="10sp" android:textColor="@color/white"
            android:background="?android:attr/selectableItemBackground" />

        <Button android:id="@+id/readerMode" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:text="Page" android:textSize="10sp" android:textColor="@color/white"
            android:background="?android:attr/selectableItemBackground" />

        <Button android:id="@+id/readerAuto" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:text="Auto" android:textSize="10sp" android:textColor="@color/white"
            android:background="?android:attr/selectableItemBackground" />

        <Button android:id="@+id/readerBright" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:text="☀ 100" android:textSize="10sp" android:textColor="@color/white"
            android:background="?android:attr/selectableItemBackground" />

        <Button android:id="@+id/readerChapters" android:layout_width="0dp" android:layout_weight="1.4" android:layout_height="match_parent"
            android:text="CHP 1/1" android:textSize="9sp" android:textColor="@color/white"
            android:background="?android:attr/selectableItemBackground" />

        <Button android:id="@+id/readerNext" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:text="Next ›" android:textSize="10sp" android:textColor="@color/white"
            android:background="?android:attr/selectableItemBackground" />
    </LinearLayout>
</LinearLayout>
