<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000">

    <WebView android:id="@+id/readerWeb" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:background="#000000" />

    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="52dp"
        android:background="#DD15151B" android:gravity="center_vertical">
        <Button android:id="@+id/readerMode" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:text="Webtoon" android:textSize="11sp" android:textColor="@color/white"
            android:background="?android:attr/selectableItemBackground" />
        <Button android:id="@+id/readerAuto" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:text="Auto" android:textSize="11sp" android:textColor="@color/white"
            android:background="?android:attr/selectableItemBackground" />
        <Button android:id="@+id/readerBright" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:text="☀ 100" android:textSize="11sp" android:textColor="@color/white"
            android:background="?android:attr/selectableItemBackground" />
        <Button android:id="@+id/readerPreload" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:text="Preload" android:textSize="11sp" android:textColor="@color/white"
            android:background="?android:attr/selectableItemBackground" />
        <Button android:id="@+id/readerBack" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:text="← Back" android:textSize="11sp" android:textColor="@color/mgs_accent"
            android:background="?android:attr/selectableItemBackground" />
    </LinearLayout>
</LinearLayout>
