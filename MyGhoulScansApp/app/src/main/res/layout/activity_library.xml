<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/mgs_bg">

    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
        android:layout_height="52dp" android:background="@color/mgs_panel" android:gravity="center_vertical"
        android:paddingStart="16dp" android:paddingEnd="10dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="My Library" android:textColor="@color/white" android:textSize="19sp" android:textStyle="bold" />
        <Button android:id="@+id/libClear" android:layout_width="wrap_content" android:layout_height="34dp"
            android:text="Clear all" android:textSize="12sp" android:textColor="@color/mgs_accent"
            android:background="?android:attr/selectableItemBackground" android:paddingStart="10dp" android:paddingEnd="10dp" />
    </LinearLayout>

    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="10dp">
        <Button android:id="@+id/libType" android:layout_width="0dp" android:layout_weight="1" android:layout_height="34dp"
            android:text="All types v" android:textSize="12sp" android:textColor="@color/white"
            android:background="@drawable/mgs_card" android:paddingStart="10dp" android:paddingEnd="10dp" />
        <Button android:id="@+id/libStatus" android:layout_width="0dp" android:layout_weight="1" android:layout_height="34dp"
            android:layout_marginStart="8dp" android:text="All status v" android:textSize="12sp" android:textColor="@color/white"
            android:background="@drawable/mgs_card" android:paddingStart="10dp" android:paddingEnd="10dp" />
    </LinearLayout>

    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingStart="12dp" android:paddingEnd="12dp"
        android:paddingTop="10dp" android:paddingBottom="6dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2.6"
            android:text="Title" android:textColor="#FF979BA8" android:textSize="11sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2"
            android:text="Continue" android:textColor="#FF979BA8" android:textSize="11sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.8"
            android:text="Status" android:textColor="#FF979BA8" android:textSize="11sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.9"
            android:text="Last Read" android:textColor="#FF979BA8" android:textSize="11sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.8"
            android:text="Updated" android:textColor="#FF979BA8" android:textSize="11sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.9"
            android:text="Added v" android:textColor="#FF979BA8" android:textSize="11sp" />
        <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:text="" />
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/libraryList" android:orientation="vertical"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="10dp" android:paddingEnd="10dp" />
    </ScrollView>

    <include layout="@layout/bottom_nav" />
</LinearLayout>
