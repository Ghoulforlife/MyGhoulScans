<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/mgs_bg">

    <TextView android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical"
        android:paddingStart="16dp" android:text="My Library" android:textColor="@color/white"
        android:textSize="19sp" android:textStyle="bold" android:background="@color/mgs_panel" />

    <EditText android:id="@+id/libSearch" android:layout_width="match_parent" android:layout_height="42dp"
        android:layout_marginStart="14dp" android:layout_marginEnd="14dp" android:layout_marginTop="12dp"
        android:hint="Search your library" android:textColor="@color/white" android:textColorHint="@color/mgs_muted"
        android:background="@drawable/mgs_card" android:paddingStart="12dp" android:singleLine="true" />

    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:scrollbars="none" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="10dp">
        <LinearLayout android:id="@+id/libFilters" android:orientation="horizontal" android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </HorizontalScrollView>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/libraryGrid" android:orientation="vertical"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="10dp" />
    </ScrollView>

    <include layout="@layout/bottom_nav" />
</LinearLayout>
